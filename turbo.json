{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "prisma:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["node_modules/.prisma/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "inputs": ["src/**", "tsconfig*.json", "package.json", "nest-cli.json", ".swcrc"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "prisma:generate"],
      "inputs": ["src/**", "test/**", "prisma/**/*.ts", "tsconfig*.json"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "prisma:generate"],
      "inputs": ["src/**", "test/**", "vitest.config.*"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^build", "prisma:generate"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
