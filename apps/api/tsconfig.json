{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": [
      "node",
      "multer"
    ],
    "declaration": false,
    "declarationMap": false,
    "module": "Node16",
    "moduleResolution": "Node16"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
