// Canon CMS — primary data model.
//
// Conventions
// - Every tenant-scoped table carries a denormalised `tenantId`, even when reachable via siteId.
//   RLS policies then stay a single equality check (no joins in policies → no planner surprises),
//   and a leaked siteId can never cross tenants.
// - Soft delete via `deletedAt`. Uniqueness that must ignore deleted rows is enforced by partial
//   unique indexes in raw SQL migrations (Prisma cannot express `WHERE "deletedAt" IS NULL`).
// - `version Int` = optimistic locking for aggregates edited concurrently (Page, Entry, Fact).
// - Vector columns are `Unsupported("vector(N)")`: read/written only through $queryRaw in repositories.
// - AnalyticsEvent / AuditLog are range-partitioned by createdAt (raw SQL); their PK includes createdAt.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, pgcrypto]
}

// ───────────────────────────────────────────────────────────────────────────
// Enums
// ───────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DISABLED
}

enum TenantPlan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum TenantIsolation {
  SHARED
  SCHEMA
  DATABASE
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  AUTHOR
  VIEWER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentEntityType {
  PAGE
  ENTRY
  MEDIA
  FORM
  FACT
}

enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  FAILED
}

enum ScheduledAction {
  PUBLISH
  UNPUBLISH
}

enum JobStatus {
