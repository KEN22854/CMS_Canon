    "opossum": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/opossum": "^8.1.9",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
