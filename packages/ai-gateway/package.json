{
  "name": "@canon/ai-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-agnostic LLM gateway: routing, fallback, caching, guardrails, cost accounting, tracing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
