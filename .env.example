# Host ports are offset from the defaults (5442, 6389, 9010…) so Canon can run next to other
# local stacks; override with CANON_*_PORT variables (see docker-compose.yml).

# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────
# Owner role: migrations + seed only.
DATABASE_URL=postgresql://canon:canon@localhost:5442/canon?schema=public
# Runtime role: subject to RLS. The API must use this one.
APP_DATABASE_URL=postgresql://canon_app:canon_app@localhost:5442/canon?schema=public
# Cross-tenant workers (outbox relay, schedulers). BYPASSRLS — never used by request handlers.
SYSTEM_DATABASE_URL=postgresql://canon_system:canon_system@localhost:5442/canon?schema=public

# ── Redis / storage / search / mail ───────────────────────────────────────
REDIS_URL=redis://localhost:6389
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=canon-media
S3_ACCESS_KEY=canon
S3_SECRET_KEY=canon-s3-secret
MEILI_URL=http://localhost:7710
MEILI_MASTER_KEY=canon-meili-master-key-dev-only
SMTP_URL=smtp://localhost:1035

# ── Auth ──────────────────────────────────────────────────────────────────
ADMIN_PUBLIC_URL=http://localhost:3000
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
AUTH_COOKIE_DOMAIN=
MAIL_FROM="Canon <no-reply@canon.local>"
MAIL_TRANSPORT=smtp

# ── Seed ──────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@canon.local
# Required by the seed; pick anything ≥ 12 chars locally.
SEED_ADMIN_PASSWORD=

# ── AI providers (any subset; gateway skips providers without a key) ─────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── AI gateway behaviour ──────────────────────────────────────────────────
AI_DEFAULT_MODEL=anthropic/claude-sonnet-5-5
AI_FALLBACK_MODELS=anthropic/claude-haiku-5-5,openai/gpt-4o-mini,ollama/llama3.1:8b,ollama/qwen2.5vl:7b
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_EXACT_CACHE_TTL_SEC=86400
AI_SEMANTIC_CACHE_ENABLED=true
AI_SEMANTIC_CACHE_THRESHOLD=0.95
AI_REQUEST_TIMEOUT_MS=60000

# ── Observability ─────────────────────────────────────────────────────────
LANGFUSE_BASE_URL=http://localhost:3110
LANGFUSE_PUBLIC_KEY=pk-lf-canon-dev
LANGFUSE_SECRET_KEY=sk-lf-canon-dev
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=canon-api

# Express trust proxy: internal networks whose X-Forwarded-For we believe
TRUST_PROXY=loopback,linklocal,uniquelocal

# ── Sites, renderer & delivery (Phase 2) ──────────────────────────────────
# Sites get <site>-<tenant>.<domain>; *.localhost needs no hosts-file entry in browsers.
PUBLIC_SITES_DOMAIN=canon.localhost
WEB_PUBLIC_PORT=3001
WEB_REVALIDATE_URL=http://localhost:3001/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret-change-me
DELIVERY_TOKEN=dev-delivery-token-change-me
S3_PUBLIC_URL=http://localhost:9010/canon-media
MEDIA_MAX_UPLOAD_MB=25

# Renderer → API (server-side only)
CANON_API_URL=http://localhost:4000

# ── Billing (Phase 7) — leave STRIPE_SECRET_KEY empty to disable online payments ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_AI_METER_EVENT=canon_ai_overage_cents

# ── SSO (Phase 7) — 'off' trusts claimed domains without DNS proof (development only) ──
SSO_DOMAIN_VERIFICATION=dns
