# Copy to deploy/.env.production and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   (JWT, tokens)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      (ENCRYPTION_KEY)
NODE_ENV=production
API_PORT=4000
API_PUBLIC_URL=https://app.example.com/api
ADMIN_PUBLIC_URL=https://app.example.com
PUBLIC_SITES_DOMAIN=sites.example.com
TRUST_PROXY=loopback,linklocal,uniquelocal

POSTGRES_USER=canon
POSTGRES_PASSWORD=
MIGRATE_DATABASE_URL=postgresql://canon:PASSWORD@postgres:5432/canon
APP_DATABASE_URL=postgresql://canon_app:PASSWORD@postgres:5432/canon
SYSTEM_DATABASE_URL=postgresql://canon_system:PASSWORD@postgres:5432/canon
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=
ENCRYPTION_KEY=
DELIVERY_TOKEN=
REVALIDATE_SECRET=
WEB_REVALIDATE_URL=http://web:3001/api/revalidate

S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=canon-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Canon <no-reply@example.com>
MAIL_TRANSPORT=smtp

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_MODEL=anthropic/claude-sonnet-5-5
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
SSO_DOMAIN_VERIFICATION=dns

LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
