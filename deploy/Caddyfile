# Canon edge: TLS for the admin, the platform sites domain and every verified custom domain.
#   docker compose -f deploy/docker-compose.prod.yml --profile edge up -d
# Set ADMIN_HOST (admin.example.com), SITES_DOMAIN (= PUBLIC_SITES_DOMAIN) and ACME_EMAIL.
{
	email {$ACME_EMAIL}
	# Certificates for customer domains are issued on the first visit — but only after Canon
	# confirms the host is a verified custom domain or a platform site, so nobody can make the
	# edge request certificates for arbitrary names.
	on_demand_tls {
		ask http://api:4000/v1/tls/ask
	}
}

{$ADMIN_HOST} {
	encode zstd gzip
	reverse_proxy admin:3000
}

# Platform sites (<site>-<workspace>.SITES_DOMAIN) and customer domains pointed at the CNAME
# target (sites.SITES_DOMAIN by default) all reach the renderer, which resolves the host.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy web:3001 {
		header_up X-Forwarded-Host {host}
	}
}
